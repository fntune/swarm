# Base URL of the deployed spawnd FastAPI server (server-side only; never NEXT_PUBLIC_).
SPAWND_API_URL=http://localhost:8765

# Optional Tailnet-only authentication. Keep the dashboard bound to localhost and
# expose it through Tailscale Serve when this mode is enabled.
# SPAWND_DASHBOARD_AUTH_MODE=tailscale
# SPAWND_TAILSCALE_ALLOWED_USERS=operator@example.com
# SPAWND_API_TOKEN=server-side-api-token
